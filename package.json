{
  "name": "careertwin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "seed:courses": "npx tsx --env-file=.env.local --conditions=react-server scripts/generate-advance-library.ts",
    "audit:learning": "npx tsx --env-file=.env.local --conditions=react-server scripts/audit-learning.ts",
    "courses:generate": "npx tsx --env-file=.env.local --conditions=react-server scripts/generate-courses.ts",
    "courses:validate": "npx tsx --env-file=.env.local --conditions=react-server scripts/validate-courses.ts",
    "courses:seed": "npx tsx --env-file=.env.local --conditions=react-server scripts/seed-courses.ts",
    "courses:audit": "npx tsx --env-file=.env.local --conditions=react-server scripts/audit-courses.ts",
    "check": "npm run lint && npm run typecheck && npm run test"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.18",
    "@google/genai": "^2.31.0",
    "@supabase/supabase-js": "^2.57.4",
    "@types/three": "^0.186.0",
    "framer-motion": "^14.5.0",
    "lucide-react": "^1.60.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "three": "^0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
