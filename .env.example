# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional published Spline scene URL for the landing hero; the built-in 3D fallback is used when empty.
NEXT_PUBLIC_SPLINE_SCENE_URL=

# Phase 2 — Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Phase 2 — Database and private storage
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional AI provider (server-side only)
# Choose gemini or openrouter. Do not prefix secret variables with NEXT_PUBLIC_.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
